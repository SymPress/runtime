{
    "name": "sympress/runtime",
    "description": "Composer-driven WordPress setup, environment configuration and deployment tools.",
    "keywords": [
        "wordpress",
        "composer",
        "environment",
        "configuration",
        "deployment"
    ],
    "homepage": "https://github.com/SymPress/runtime",
    "support": {
        "issues": "https://github.com/SymPress/runtime/issues",
        "source": "https://github.com/SymPress/runtime",
        "docs": "https://github.com/SymPress/runtime/tree/main/docs"
    },
    "archive": {
        "exclude": [
            "/.github",
            "/docs/maintainers",
            "/tests",
            "/tools",
            "/AGENTS.md",
            "/phpcs.xml.dist",
            "/phpstan.neon.dist",
            "/phpunit.xml.dist",
            "/vendor",
            "/build",
            "/composer.lock",
            "/.phpunit.cache",
            "/.phpstan.cache",
            "/.subversion",
            "/.env",
            "/.env.*",
            "/.gitignore",
            "/.gitattributes",
            "/.wp-cli"
        ]
    },
    "type": "composer-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.5",
        "composer-plugin-api": "^2.6",
        "composer/composer": "~2.10.3",
        "composer/semver": "^3.4",
        "opis/json-schema": "^2.6",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/event-dispatcher": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/http-client": "^8.1",
        "symfony/process": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "sympress/kernel": "^1.1.1",
        "sympress/qa": "^0.1.2"
    },
    "conflict": {
        "symfony/event-dispatcher-contracts": "<3.4.2"
    },
    "autoload": {
        "psr-4": {
            "SymPress\\Runtime\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SymPress\\Runtime\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/runtime"
    ],
    "extra": {
        "class": "SymPress\\Runtime\\Composer\\Plugin",
        "branch-alias": {
            "dev-main": "1.2.x-dev"
        },
        "kernel": {
            "bundle": "SymPress\\Runtime\\Bridge\\Kernel\\RuntimeBundle",
            "entry": "sympress/runtime"
        }
    },
    "suggest": {
        "sympress/kernel": "Enables runtime diagnostics, validation and environment dumps through wp console."
    },
    "scripts": {
        "cs": "qa cs --strict",
        "cs:fix": "qa cs:fix --strict",
        "static-analysis": "qa static-analysis --strict",
        "tests": "qa tests --strict",
        "test": "@tests",
        "qa": [
            "@cs",
            "@static-analysis",
            "@tests"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
